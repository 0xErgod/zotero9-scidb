{
  "name": "zotero9-scidb",
  "version": "0.0.4",
  "description": "Zotero SciDB Downloader",
  "config": {
    "addonName": "Zotero SciDB Downloader",
    "addonID": "zotero9-scidb@dev.null",
    "addonRef": "zoteroscidb",
    "addonInstance": "ZoteroSciDB",
    "prefsPrefix": "extensions.zotero.zoteroscidb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xErgod/zotero9-scidb.git"
  },
  "author": "0xErgod",
  "bugs": {
    "url": "https://github.com/0xErgod/zotero9-scidb/issues"
  },
  "homepage": "https://github.com/0xErgod/zotero9-scidb#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "lint": "prettier --write . && eslint . --fix",
    "lint:check": "prettier --check . && eslint .",
    "release": "zotero-plugin release",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:zotero": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "mocha": "^11.1.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.0.5",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
